{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "装配 install（版本取 git describe）",
            "detail": "版本号自动取 git describe（如 v1.0.3-9-g9476aca，带未提交改动时加 -dirty），永远不会过期；只影响界面显示",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "tools/dev_install.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "装配 install（指定版本）",
            "detail": "手动指定版本号（只影响界面显示，不参与构建）",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "tools/dev_install.ps1",
                "-Version",
                "${input:installVersion}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "同步 pipeline（仅 JSON）",
            "detail": "只改 pipeline 时用它，比整包装配快；改了图片或 interface.json 请改跑装配任务",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Copy-Item 'assets\\resource\\pipeline\\*.json' 'install\\resource\\pipeline\\' -Force; Write-Host 'pipeline synced'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "启动 GUI（install/DMA.exe）",
            "detail": "先杀掉已在运行的 DMA，再启动新实例（资源只在启动时加载）",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-Process DMA -ErrorAction SilentlyContinue | Stop-Process -Force; Start-Sleep -Milliseconds 300; Start-Process -FilePath '.\\install\\DMA.exe' -WorkingDirectory '.\\install'; Write-Host 'DMA started'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "实测：装配 + 启动",
            "detail": "日常回路：改完 assets → 装配 → 重启 GUI",
            "dependsOrder": "sequence",
            "dependsOn": [
                "装配 install（版本取 git describe）",
                "启动 GUI（install/DMA.exe）"
            ],
            "problemMatcher": []
        },
        {
            "label": "校验：schema",
            "detail": "与 CI 的 check.yml 第一步等价（JSON Schema 校验）",
            "type": "shell",
            "command": "python",
            "args": [
                "tools/validate_schema.py",
                "--schema-dir",
                "deps/tools",
                "--resource-dirs",
                "assets/resource",
                "--exclude-dirs",
                "assets/resource/announcement",
                "--interface-files",
                "assets/interface.json"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "校验：maa-tools check",
            "detail": "与 CI 的 check.yml 第二步等价；按 maaVersion（v5.14.3）做语义检查",
            "type": "shell",
            "command": "npx",
            "args": [
                "@nekosu/maa-tools",
                "check"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "实测：全流程（校验 → 装配 → 启动）",
            "detail": "两层校验 + 装配 + 重启 GUI，一条命令走完",
            "dependsOrder": "sequence",
            "dependsOn": [
                "校验：schema",
                "校验：maa-tools check",
                "装配 install（版本取 git describe）",
                "启动 GUI（install/DMA.exe）"
            ],
            "problemMatcher": []
        },
        {
            "label": "跟随日志（maafw.log）",
            "detail": "实时 tail install/debug/maafw.log（会一直占用终端，Ctrl+C 结束）",
            "type": "process",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-Content '.\\install\\debug\\maafw.log' -Wait -Tail 40"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "installVersion",
            "type": "pickString",
            "description": "装配用的版本号（只影响界面显示，不参与构建）",
            "options": [
                "v1.0.4-dev",
                "v1.0.4",
                "v1.0.5-dev",
                "v0.0.0-dev"
            ],
            "default": "v1.0.4-dev"
        }
    ]
}
