{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "DMA",
    "description": "用于DNA的自动软件",
    "contact": "QQ:2359933809",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 DMA!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/abyss-stars/DMA",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource"
                // "./resource_bilibili"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    // 任务可选项：通用 UI 会据此渲染下拉框
    // 文档: https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "option": {
        "挂机角色": {
            "type": "select",
            "label": "挂机角色",
            "description": "选择自动战斗时使用的角色技能模板",
            "default_case": "艾达挂机",
            "cases": [
                {
                    "name": "艾达挂机",
                    "label": "艾达挂机",
                    // 艾达：大招 + E 技能都识别（与 pipeline 默认值一致，显式写出便于对照）
                    "pipeline_override": {
                        "qSkill": {
                            "template": "abyss/skill/艾达大招.png",
                            "next": [
                                "eSkill"
                            ]
                        },
                        "eSkill": {
                            "template": "abyss/skill/艾达e技能.png",
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "芙罗拉挂机",
                    "label": "芙罗拉挂机",
                    // 芙罗拉：只放大招；暂无可用的 E 技能模板，故跳过 eSkill 直接回主循环
                    "pipeline_override": {
                        "qSkill": {
                            "template": "abyss/skill/fll大招.png",
                            "next": [
                                "AbyssMainLoop"
                            ]
                        },
                        "eSkill": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    },
    "task": [
        {
            "name": "深渊循环",
            "entry": "AbyssMainLoop",
            "option": [
                "挂机角色"
            ],
            "description": "用于处于深渊重试或者下一层界面时的无限自动刷取深渊代币"
        }
    ]
}