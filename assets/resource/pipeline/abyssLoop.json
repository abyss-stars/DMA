{
    // 深渊内的无限循环（进入导航见 enterAbyss.json）
    "AbyssMainLoop": {
        "timeout": -1,
        "rate_limit": 2000,
        "next": [
            "AbyssStart",
            "AbyssAlign",
            "AbyssNextFloor",
            "AbyssRestart"
        ]
    },
    "AbyssNextFloor": {
        "recognition": "TemplateMatch",
        "template": "abyss/nextfloor.png",
        "roi": [
            920,
            620,
            360,
            100
        ],
        "action": "Click",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 40000,
        "on_error": [
            "AbyssMainLoop"
        ],
        "next": [
            "AbyssAlign"
        ]
    },
    "AbyssRestart": {
        "recognition": "TemplateMatch",
        "template": "abyss/restart.png",
        "action": "Click",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 40000,
        "on_error": [
            "AbyssMainLoop"
        ],
        "next": [
            "AbyssAlign"
        ]
    },
    "AbyssAlign": {
        "desc": "开启深渊：抬视角×5 → 右转对准 instruction_icon → 前进1.5s → 微调5次仍未见「开始深渊」则 ErrorExit+ClickRestart+Confirm 重开（最多2次）（Python: abyss_align）",
        "recognition": "TemplateMatch",
        "template": "abyss/start.png",
        "roi": [
            58,
            238,
            218,
            63
        ],
        "action": "Custom",
        "custom_action": "abyss_align",
        "custom_action_param": {
            // 1) 抬视角 ×5（对应 MoveViewUp）
            "view_up": {
                "begin": [
                    550,
                    140,
                    63,
                    41
                ],
                "end": [
                    550,
                    53,
                    64,
                    36
                ],
                "duration": 300,
                "times": 5,
                "delay": 300
            },
            // 2) 右转小步直到在 icon 的 roi 内看到指示图标（对应 MoveViewRight）
            "view_right": {
                "begin": [
                    461,
                    61
                ],
                "end": [
                    500,
                    61
                ],
                "duration": 300,
                // 画面至少静止这么久（agent 用 wait_freezes，失败退回固定等待）
                "settle": 300,
                "max_times": 45
            },
            "icon": "InstructionIcon",
            // 3) 前进：只需要 x,y 两个点（对应 MoveForward）
            "forward": {
                "begin": [
                    208,
                    533
                ],
                "end": [
                    220,
                    440
                ],
                "duration": 1500,
                "settle": 300
            },
            // 4) 未见「开始深渊」时每次前进一小步，坐标复用 forward（对应 MoveForwardShort）
            "step": {
                "duration": 200,
                // 小步之后等画面静止的时间
                "settle": 200,
                "max_times": 5
            },
            // 5) 微调 5 次仍未成功 → ErrorExit → ClickRestart → Confirm 三步重开本次深渊，再完整跑一轮
            "restart": {
                "enabled": true,
                "max_times": 2,
                "exit_node": "ErrorExit",
                "restart_node": "ClickRestart",
                // 「确定」二次确认，复用 enterAbyss.json 的同名节点；置空可跳过
                "confirm_node": "Confirm",
                "dialog_timeout": 5,
                "ready_node": "AbyssAlign",
                "ready_timeout": 15
            },
            "target": "AbyssStart"
        },
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 6000,
        "on_error": [
            "AbyssMainLoop"
        ],
        "next": [
            "AbyssStart"
        ]
    },
    "AbyssStart": {
        "recognition": "TemplateMatch",
        "template": "abyss/开始深渊.png",
        "roi": [
            630,
            310,
            380,
            100
        ],
        "action": "Click",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 20000,
        "on_error": [
            "AbyssMainLoop"
        ],
        "next": [
            "AbyssAttack"
        ]
    },
    "AbyssAttack": {
        "recognition": "TemplateMatch",
        "template": "abyss/start.png",
        "roi": [
            58,
            238,
            218,
            63
        ],
        "inverse": true,
        "pre_delay": 0,
        "post_delay": 500,
        "timeout": 30000,
        "on_error": [
            "AbyssMainLoop"
        ],
        "next": [
            "qSkill"
        ]
    },
    "qSkill": {
        "recognition": "TemplateMatch",
        "template": "abyss/skill/艾达大招.png",
        "roi": [
            880,
            560,
            180,
            160
        ],
        "action": "Click",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 30000,
        "on_error": [
            "AbyssMainLoop"
        ],
        "next": [
            "eSkill"
        ]
    },
    "eSkill": {
        "recognition": "TemplateMatch",
        "template": "abyss/skill/艾达e技能.png",
        "roi": [
            800,
            570,
            180,
            150
        ],
        "action": "Click",
        "pre_delay": 0,
        "post_delay": 0,
        "timeout": 30000,
        "next": [
            "AbyssMainLoop"
        ]
    },
    "InstructionIcon": {
        "desc": "指向深渊入口的 instruction_icon（仅作为 abyss_align 的识别目标，不参与流程）",
        "recognition": "TemplateMatch",
        "template": "common/instruction_icon.png",
        "roi": [
            608,
            497,
            66,
            52
        ],
        "action": "DoNothing"
    },
    "ErrorExit": {
        "desc": "重开第 1 步：关卡异常退出按钮（点开退出/重开菜单）",
        "recognition": "TemplateMatch",
        "template": "common/errorexit.png",
        "roi": [
            12,
            6,
            80,
            59
        ],
        "action": "Click",
        "next": [
            "ClickRestart"
        ]
    },
    "ClickRestart": {
        "desc": "重开第 2 步：菜单里的「重新开始」（点完弹「确定」确认框）",
        "recognition": "TemplateMatch",
        "template": "common/restart.png",
        "roi": [
            988,
            602,
            116,
            84
        ],
        "action": "Click",
        "next": [
            "Confirm"
        ]
    }
}





